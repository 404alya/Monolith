build/
build-linux/
build-linux-profile/
build-mingw/
screenshot*.png

# Benchmark reports written by --bench (local results)
benchmark/

# In-game map edit requests (bundles for Claude Code, see src/launcher.c)
requests/

# Local editor config (machine-specific absolute paths)
.clangd
# clangd's compilation database (written by ./build.sh, absolute paths) and its index
compile_commands.json
.cache/

# Vendored R3D: parts not used by the monolith build (examples/tests are OFF)
submodules/r3d/examples/
submodules/r3d/external/assimp/test/
submodules/r3d/external/raylib/examples/

# Map exports written by F9 (src/export.c); examples/build/ is covered by build/ above
export/
# ... but runtime/export/ holds the export's templates (viewer.c, build.sh, nob.c): source
!runtime/export/

# Compiled maps (monolith --compile, docs/compiled-map.md): build output of exports and examples
*.mapb

# Maps are local, except the pine_forest package and the monolith submodule
maps/*
!maps/pine_forest/
!maps/monolith/

# Claude Code: per-developer settings and agent worktrees
.claude/settings.local.json
.claude/worktrees/
